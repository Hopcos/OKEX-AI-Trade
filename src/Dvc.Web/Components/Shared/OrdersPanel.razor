@inject ScopedUiBridge Ui

<h3 class="card-title">订单流水 · Trade_Order</h3>

<div class="table-scroll">
    <table class="table">
        <thead>
            <tr>
                <th>时间</th><th>币种</th><th>方向</th><th>价格</th><th>金额</th><th>状态</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Store.Orders.Take(24))
            {
                <tr>
                    <td>@Fmt.Time(o.Ts)</td>
                    <td>@o.Symbol</td>
                    <td class="@(o.Side == "Buy" ? "pos" : "neg")">@(o.Side == "Buy" ? "买入" : "卖出")</td>
                    <td>@Fmt.Price(o.Price)</td>
                    <td>$@Fmt.Money(o.AmountUsd)</td>
                    <td>
                        <span class="status @StatusClass(o.Status)">@StatusText(o.Status, o.Tag)</span>
                        @if (o.RealizedPnl != 0)
                        {
                            <span class="pnl @(o.RealizedPnl >= 0 ? "pos" : "neg")">@Fmt.Signed(o.RealizedPnl)</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Store.Orders.Count == 0)
    {
        <div class="hint">暂无订单（AI 挂单后此处实时推进）</div>
    }
</div>

@code {
    private UiEventStore Store => Ui.Store;

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private async void OnChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;

    private static string StatusClass(string s) => s switch
    {
        "Filled" => "status-ok",
        "Cancelled" => "status-mid",
        "Rejected" => "status-bad",
        _ => "status-run",
    };

    private static string StatusText(string s, string tag) => s switch
    {
        "Filled" => "已成交",
        "Cancelled" => "已撤销",
        "Rejected" => "被拒",
        "Pending" => "挂单中",
        "Queued" => "排队中",
        _ => s + (string.IsNullOrEmpty(tag) ? "" : $"·{tag}"),
    };
}
