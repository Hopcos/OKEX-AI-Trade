@inject ScopedUiBridge Ui

<h3 class="card-title">🛡 风控盾牌拦截计数器</h3>

<div class="shield">
    <div class="shield-num">@(Store.Account?.ShieldCount ?? 0)</div>
    <div class="shield-sub">AI 幻觉报单拦截次数（黑名单 / 超额 / 非法动作）</div>
</div>

@if (Store.Halts.Count > 0)
{
    <div class="halt-banner">
        🚨 系统级硬熔断已触发：@Store.Halts[0].Reason
    </div>
}

<h4 class="sub-title">最近拦截记录</h4>
<div class="scroll-list">
    @foreach (var f in Store.Flows.Where(f => f.Message.Contains("🛡")).Take(8))
    {
        <div class="log-line warn">@f.Message</div>
    }
    @if (!Store.Flows.Any(f => f.Message.Contains("🛡")))
    {
        <div class="hint">暂无拦截，风控盾牌守护中……</div>
    }
</div>

@code {
    private UiEventStore Store => Ui.Store;

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private async void OnChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;
}
